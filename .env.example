# =============================================================================
# REGCOBRE — VARIÁVEIS DE AMBIENTE (MODELO .env.example)
# Copie este arquivo para .env no servidor Ubuntu (VM srv-app) e defina os valores locais.
# NUNCA insira senhas reais neste modelo ou envie o arquivo .env para o repositório.
# =============================================================================

# Configuração do Servidor da Aplicação
PORT=3000
NODE_ENV=development

# Conexão com o PostgreSQL 18.6 (Acesso Local Restrito à VM srv-app)
# Não exponha a porta 5432 publicamente; mantenha DB_HOST como 127.0.0.1 ou localhost.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=regcobre
DB_USER=regcobre_app
DB_PASSWORD=
DB_SSL=false

# Configurações do Pool de Conexões
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECT_TIMEOUT=5000

# Chaves de Integração (Opcionais)
GEMINI_API_KEY=
